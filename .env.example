# ─────────────────────────────────────────────
#  YouTube Shorts Auto-Generator — ENV Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Gemini AI ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Extra keys for quota rotation (optional): GEMINI_API_KEY_2 … GEMINI_API_KEY_10
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001
# Output cap — keep >=4096: gemini-2.5 thinking tokens count against this too.
GEMINI_MAX_OUTPUT_TOKENS=4096
# Cache generated content per topic so re-runs cost zero tokens.
CONTENT_CACHE=true

# ── YouTube Data API v3 ────────────────────────
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token
# Get this from: scripts/setup_youtube_auth.py

# ── Unsplash (free image fallback) ────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ── Google Trends ──────────────────────────────
TRENDS_GEO=IN
TRENDS_COUNT=20

# ── Video Generation ──────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION=60
SHORTS_PER_RUN=1

# ── YouTube Upload ─────────────────────────────
YOUTUBE_PRIVACY_STATUS=public
# Options: public | private | unlisted
YOUTUBE_CATEGORY_ID=22
# 22=People&Blogs, 24=Entertainment, 25=News, 28=Science&Tech
DISABLE_AUTO_UPLOAD=true
# Set to true to disable automatic YouTube uploads (from scheduler, cron or auto jobs)

# ── Voiceover (edge-tts, free) ─────────────────
# en = Indian English | hi = Hindi | hinglish = mixed
TTS_LANGUAGE=en
# Optional explicit voice override, e.g. en-IN-PrabhatNeural
TTS_VOICE=

# ── Channel Branding ──────────────────────────
CHANNEL_NAME=TrendSnap AI
CHANNEL_WATERMARK=@TrendSnapAI

# ── Dashboard → GitHub Actions control ────────
# Classic token with `repo` + `workflow` scopes; lets the dashboard trigger
# and monitor the cloud pipeline. Falls back to `gh auth token` if empty.
GITHUB_TOKEN=

# ── Paths (optional overrides) ────────────────
# DATA_DIR=./data
# LOGS_DIR=./logs
# GENERATED_DIR=./generated

# ── Reliability ───────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=5
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════
#  KIDS CARTOON MODE  (the production pipeline)
# ═══════════════════════════════════════════════
# kids → original kids-cartoon stories (default) | trends → legacy facts pipeline
CONTENT_MODE=kids
# Hindi-first kids content: hi | hinglish | en
KIDS_LANGUAGE=hi
KIDS_TARGET_SECONDS=45
KIDS_SCENE_COUNT=6
KIDS_MAX_CHARACTERS=3
# COPPA: declare kids videos as "made for kids" on upload
YOUTUBE_MADE_FOR_KIDS=true
NARRATOR_VOICE=hi-IN-MadhurNeural

# ── Local image backend (Phase 2; safe to leave default for now) ─────────
# auto → local (comfyui/a1111) then Gemini then gradient fallback
IMAGE_BACKEND=auto
COMFYUI_URL=http://127.0.0.1:8188
A1111_URL=http://127.0.0.1:7860
SD_MODEL=
SD_STEPS=24
IMAGE_TIMEOUT=600

# ── Lip-sync (Phase 3; optional, heavy on CPU — off by default) ──────────
LIPSYNC_ENABLED=false
LIPSYNC_BACKEND=wav2lip

# ── Background music ──────────────────────────
MUSIC_VOLUME=0.12
